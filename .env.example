# ─────────────────────────────────────────────────────────────────────────────
# AI Profit Dashboard – environment variables
# Copy to .env.local and fill in what you have. EVERYTHING is optional:
# missing data sources fall back to demo data, a missing AI key falls back to
# the rule-based demo assistant. Keys can also be entered in the UI
# (Settings → stored in an encrypted httpOnly cookie, which overrides these).
# ─────────────────────────────────────────────────────────────────────────────

# ── Security (REQUIRED in production) ────────────────────────────────────────
# Encrypts the credentials cookie. Generate: openssl rand -base64 32
CREDENTIALS_SECRET=
# Protects /api/insights/cron (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET=

# ── AI model (one key is enough) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
# Optional overrides: anthropic | openai | gateway | demo
AI_PROVIDER=
# e.g. claude-sonnet-5-5, gpt-6-astra, anthropic/claude-sonnet-5.5
AI_MODEL=

# ── Shopify (custom app: read_orders, read_products, read_inventory, read_returns)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# ── Google Ads ───────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only when accessing the account through a manager (MCC) account
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Meta Ads (system-user token with ads_read) ───────────────────────────────
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_

# ── Business cost settings (non-secret, defaults shown) ──────────────────────
SHIPPING_COST_PER_ORDER=6.5
PAYMENT_FEE_PCT=0.029
PAYMENT_FEE_FIXED=0.3

# ── Proactive alerts (optional) ──────────────────────────────────────────────
# Incoming webhook; the daily cron posts critical findings here
SLACK_WEBHOOK_URL=
